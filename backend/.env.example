# Server
PORT=3011
FRONTEND_URL=http://localhost:8080
# Produção: FRONTEND_URL=https://mautone.com.br

# Mailgun API
# Private API key em: https://app.mailgun.com/settings/api_security
MAILGUN_API_KEY=sua-private-api-key
# Se a conta for da UE: MAILGUN_URL=https://api.eu.mailgun.net
# MAILGUN_URL=https://api.mailgun.net
MAILGUN_DOMAIN=mautone.com.br
MAILGUN_FROM_EMAIL=contato@mautone.com.br

# Destino das mensagens do formulário
CONTACT_EMAIL=promautone@gmail.com
MAILGUN_TO_EMAIL=promautone@gmail.com
